# Copy to dash-watcher.env (untracked — same convention as .env.<project>) and
# reference it from dash-watcher.service's EnvironmentFile=.
#
# Switching which branch preprod tracks (e.g. development -> production) is
# just editing this value and running: sudo systemctl restart dash-watcher
DASH_WATCHER_BRANCH=development

# Set to 1 only if this host has NO dash-backend checkout at all (running
# purely off a published DASH_IMAGE — see docker-compose.image-only.yml).
# Leave unset/0 if dash-backend is cloned here, so core changes keep
# auto-rebuilding local/dash-backend-core:latest as designed.
#DASH_WATCHER_SKIP_CORE=1
