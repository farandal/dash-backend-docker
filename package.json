{
  "name": "dash-backend-image",
  "version": "1.0.0",
  "description": "This folder runs the DASH backend for any configured domain project using the shared Docker Hub image instead of building `dash-backend` locally.",
  "main": "index.js",
  "scripts": {
    "dash:start": "node ./scripts/run-local.mjs",
    "dash:vanexa:local": "node ./scripts/run-local.mjs vanexa local",
    "dash:vanexa:tunnel": "node ./scripts/run-local.mjs vanexa tunnel",
    "dash:vanexa:production": "node ./scripts/run-local.mjs vanexa production",
    "dash:fablabos:local": "node ./scripts/run-local.mjs fablabos local",
    "dash:fablabos:tunnel": "node ./scripts/run-local.mjs fablabos tunnel",
    "dash:fablabos:production": "node ./scripts/run-local.mjs fablabos production",
    "dash:reddorada:local": "node ./scripts/run-local.mjs reddorada local",
    "dash:reddorada:tunnel": "node ./scripts/run-local.mjs reddorada tunnel",
    "dash:reddorada:production": "node ./scripts/run-local.mjs reddorada production",
    "dash:kitchntabs:local": "node ./scripts/run-local.mjs kitchntabs local",
    "dash:kitchntabs:tunnel": "node ./scripts/run-local.mjs kitchntabs tunnel",
    "dash:kitchntabs:production": "node ./scripts/run-local.mjs kitchntabs production",
    "docs:generate": "node ./scripts/generate-api-docs.js",
    "docs:start": "pnpm docs:generate && docker compose up -d api_docs",
    "cloudflare:tunnel": "node ./scripts/cloudflare-tunnel.js",
    "cloudflare:tunnel:vanexa": "node ./scripts/cloudflare-tunnel.js --env-file .env.vanexa",
    "cloudflare:tunnel:fablabos": "node ./scripts/cloudflare-tunnel.js --env-file .env.fablabos",
    "cloudflare:tunnel:reddorada": "node ./scripts/cloudflare-tunnel.js --env-file .env.reddorada",
    "cloudflare:tunnel:kitchntabs": "node ./scripts/cloudflare-tunnel.js --env-file .env.kitchntabs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1"
  }
}
