# ----------------------------------------------------------------------------
# dash-backend-docker/.env.local.example
#
# Purpose:
# - This is the Laravel application env file mounted into the app container as
#   /var/www/dash/.env.
# - Laravel reads these values through env() and exposes them via config/*.php,
#   queue/mail/broadcast/database services, and domain boot logic.
#
# Keep in sync with:
# - dash-backend-docker/.env for shared DB credentials and DB names
# - dash-backend/config/*.php consumers referenced below
# - any mounted domain code that reads env() directly
#
# Important:
# - This file is consumed by Laravel, not by Docker Compose directly.
# - The database credentials here must match the compose-level values in
#   dash-backend-docker/.env and dash-backend-docker/docker-compose.yml.
# ----------------------------------------------------------------------------

# Application display name.
# Used by: dash-backend/config/app.php and mail sender naming.
APP_NAME=DashPanel

# Laravel environment name.
# Used by: dash-backend/config/app.php and environment-specific behavior.
APP_ENV=local

# Laravel application encryption key.
# Used by: dash-backend/config/app.php for encryption, cookies, and signed data.
APP_KEY=base64:MASKED_APP_KEY

# Application cipher implementation.
# Used by: dash-backend/config/app.php.
APP_CIPHER=AES-256-CBC

# Debug mode toggle.
# Used by: dash-backend/config/app.php and exception rendering.
APP_DEBUG=true

# Backend base URL.
# Used by: dash-backend/config/app.php and URL generation.
APP_URL=http://localhost

# Application port exposed inside app-level tooling and URLs.
# Used by: mounted scripts and some runtime helpers.
APP_PORT=8000

# Seeded system admin email.
# Used by: seeders, auth tests, and permission config.
SYSTEM_ADMIN_EMAIL=admin@example.com

# Seeded system admin password.
# Used by: seeders and authentication tests.
SYSTEM_ADMIN_PASSWORD=abcd1234...

# Default tenant seed name.
# Used by: seeders and tenant bootstrap logic.
DEFAULT_TENANT_NAME=MockTenant

# Default tenant public id seed value.
# Used by: seeders and tenant bootstrap logic.
DEFAULT_TENANT_PUBLIC_ID=00.000.000-0

# Seeded tenant admin email.
# Used by: seeders and feature tests.
TENANT_ADMIN_EMAIL=tenant@example.com

# Seeded tenant admin password.
# Used by: seeders and feature tests.
TENANT_ADMIN_PASSWORD=abcd1234...

# Seeded normal user email.
# Used by: seeders and feature tests.
NORMAL_USER_EMAIL=user@example.com

# Seeded normal user password.
# Used by: seeders and feature tests.
NORMAL_USER_PASSWORD=abcd1234...

# Main Laravel log channel.
# Used by: dash-backend/config/logging.php.
LOG_CHANNEL=stack

# Deprecated log channel selection.
# Used by: dash-backend/config/logging.php.
LOG_DEPRECATIONS_CHANNEL=null

# Minimum application log level.
# Used by: dash-backend/config/logging.php.
LOG_LEVEL=debug

# Default DB driver.
# Used by: dash-backend/config/database.php.
DB_CONNECTION=pgsql

# Database host reachable from the app container.
# Used by: dash-backend/config/database.php.
DB_HOST=pgsql

# Database TCP port.
# Used by: dash-backend/config/database.php.
DB_PORT=5432

# Primary application database name.
# Used by: dash-backend/config/database.php.
# Must match: DB_DATABASE in dash-backend-docker/.env.
DB_DATABASE=dash_dev_db

# Database username.
# Used by: dash-backend/config/database.php.
# Must match: DB_USERNAME in dash-backend-docker/.env.
DB_USERNAME=dashpanel

# Database password.
# Used by: dash-backend/config/database.php.
# Must match: DB_PASSWORD in dash-backend-docker/.env.
DB_PASSWORD=abcd1234...

# Local host-forwarded PostgreSQL port for developer tools.
# Used by: humans and external DB clients, not Laravel itself.
FORWARD_DB_PORT=54321

# Test database name for php artisan test.
# Used by: dash-backend/config/database.php testing connection.
# Must match: DB_DATABASE_TEST in dash-backend-docker/.env.
DB_DATABASE_TEST=dash_dev_db_test

# Optional synchronous queue mode for debugging.
# Used by: dash-backend/config/queue.php when uncommented.
#QUEUE_CONNECTION=sync

# Active queue backend.
# Used by: dash-backend/config/queue.php.
QUEUE_CONNECTION=redis

# Broadcast driver for events and realtime notifications.
# Used by: dash-backend/config/broadcasting.php.
BROADCAST_DRIVER=reverb

# Cache backend.
# Used by: dash-backend/config/cache.php.
CACHE_DRIVER=file

# Default filesystem disk.
# Used by: dash-backend/config/filesystems.php.
FILESYSTEM_DISK=local

# Session storage backend.
# Used by: dash-backend/config/session.php.
SESSION_DRIVER=file

# Session lifetime in minutes.
# Used by: dash-backend/config/session.php.
SESSION_LIFETIME=120

# Memcached host placeholder.
# Used by: dash-backend/config/cache.php when memcached is selected.
MEMCACHED_HOST=memcached

# Reverb server connection name.
# Used by: dash-backend/config/reverb.php.
REVERB_SERVER=reverb

# Reverb bind host inside the container.
# Used by: dash-backend/config/reverb.php.
# Keep as 0.0.0.0 so Reverb listens on all container interfaces.
REVERB_SERVER_HOST=0.0.0.0

# Reverb bind port inside the container.
# Used by: dash-backend/config/reverb.php.
# The compose file maps host:DBI_REVERB_SERVER_PORT to this container port.
REVERB_SERVER_PORT=25001

# Reverb app registry backend.
# Used by: dash-backend/config/reverb.php.
REVERB_APPS_DRIVER=redis

# Redis connection name used by Reverb.
# Used by: dash-backend/config/reverb.php and dash-backend/config/database.php.
REVERB_APPS_REDIS_CONNECTION=default

# Redis prefix for Reverb app registry keys.
# Used by: dash-backend/config/reverb.php.
REVERB_APPS_REDIS_PREFIX=reverb:apps

# Public hostname browsers use to open the WebSocket connection.
# Used by: dash-backend/config/broadcasting.php -> reverb.options.host.
# MUST be the host machine name (localhost) NOT the bind address (0.0.0.0).
# Using 0.0.0.0 here causes the browser to connect to ws://0.0.0.0:PORT which always fails.
REVERB_HOST=localhost

# Public port browsers use to open the WebSocket connection.
# Used by: dash-backend/config/broadcasting.php -> reverb.options.port.
# Must match DBI_REVERB_SERVER_PORT in dash-backend-docker/.env (the host-side port mapping).
REVERB_PORT=25001

# Optional HTTPS Reverb scheme.
# Used by: dash-backend/config/reverb.php when uncommented.
#REVERB_SCHEME=https

# Active Reverb scheme.
# Used by: dash-backend/config/reverb.php.
REVERB_SCHEME=http

# Reverb ping interval in seconds.
# Used by: dash-backend/config/reverb.php.
REVERB_APP_PING_INTERVAL=60

# Reverb inactivity timeout in seconds.
# Used by: dash-backend/config/reverb.php.
REVERB_APP_ACTIVITY_TIMEOUT=30

# Maximum allowed Reverb message payload size.
# Used by: dash-backend/config/reverb.php.
REVERB_APP_MAX_MESSAGE_SIZE=10000

# Reverb application id.
# Used by: dash-backend/config/reverb.php and websocket auth.
REVERB_APP_ID=mock_app

# Reverb application public key.
# Used by: dash-backend/config/reverb.php and frontend broadcasting clients.
REVERB_APP_KEY=mock_key

# Reverb application secret.
# Used by: dash-backend/config/reverb.php and websocket auth signing.
REVERB_APP_SECRET=MASKED_REVERB_APP_SECRET

# Redis host for cache, queue, broadcasts, and preferences.
# Used by: dash-backend/config/database.php and related services.
REDIS_HOST=redis

# Redis password.
# Used by: dash-backend/config/database.php.
REDIS_PASSWORD=null

# Redis port.
# Used by: dash-backend/config/database.php.
REDIS_PORT=6379

# Redis key prefix.
# Used by: dash-backend/config/database.php.
REDIS_PREFIX=mock_prefix_

# Redis PHP client implementation.
# Used by: dash-backend/config/database.php.
REDIS_CLIENT=predis

# Local host-forwarded Redis port for developer tools.
# Used by: humans and external Redis clients, not Laravel itself.
FORWARD_REDIS_PORT=6379

# Legacy websocket port used by BeyondCode-compatible flows.
# Used by: websocket-related config and legacy clients.
LARAVEL_WEBSOCKETS_PORT=25001

# Legacy websocket domain identifier.
# Used by: websocket-related config and legacy clients.
LARAVEL_WEBSOCKETS_DOMAIN=local

# Legacy websocket path.
# Used by: websocket-related config and legacy clients.
LARAVEL_WEBSOCKETS_PATH=ws

# Websocket replication backend mode.
# Used by: websocket-related config and realtime replication.
WEBSOCKETS_REPLICATION_MODE=redis

# Redis connection name for websocket replication.
# Used by: websocket-related config and dash-backend/config/database.php.
WEBSOCKETS_REDIS_REPLICATION_CONNECTION=default

# Allowed websocket domains.
# Used by: websocket-related config and broadcast auth.
LARAVEL_WEBSOCKETS_DOMAINS=local,localhost,localhost:8000,localhost:3000,127.0.0.1:8000,127.0.0.1:3000,*

# Pusher-compatible app id for frontend broadcasting.
# Used by: dash-backend/config/broadcasting.php.
PUSHER_APP_ID=local

# Pusher-compatible app key for frontend broadcasting.
# Used by: dash-backend/config/broadcasting.php.
PUSHER_APP_KEY=local

# Pusher-compatible app secret for frontend broadcasting.
# Used by: dash-backend/config/broadcasting.php.
PUSHER_APP_SECRET=local

# Optional explicit Pusher host.
# Used by: dash-backend/config/broadcasting.php when uncommented.
#PUSHER_APP_HOST=0.0.0.0

# Pusher-compatible websocket port.
# Used by: dash-backend/config/broadcasting.php.
PUSHER_APP_PORT=6001

# Pusher-compatible websocket scheme.
# Used by: dash-backend/config/broadcasting.php.
PUSHER_APP_SCHEME=http

# Optional websocket-native scheme for frontend experiments.
# Used by: dash-backend/config/broadcasting.php when uncommented.
#PUSHER_APP_SCHEME=ws

# Pusher cluster placeholder.
# Used by: dash-backend/config/broadcasting.php and frontend env mirroring.
PUSHER_APP_CLUSTER=mt1

# Active Laravel mailer.
# Used by: dash-backend/config/mail.php.
MAIL_MAILER=smtp

# SMTP host.
# Used by: dash-backend/config/mail.php.
MAIL_HOST=mailhog

# SMTP port.
# Used by: dash-backend/config/mail.php.
MAIL_PORT=1025

# SMTP username.
# Used by: dash-backend/config/mail.php.
MAIL_USERNAME=null

# SMTP password.
# Used by: dash-backend/config/mail.php.
MAIL_PASSWORD=null

# Legacy duplicate mail password entry kept for compatibility with existing examples.
# Used by: dash-backend/config/mail.php if left duplicated in copied envs.
MAIL_PASSWORD=null

# Mail transport encryption mode.
# Used by: dash-backend/config/mail.php.
MAIL_ENCRYPTION=null

# Default From address.
# Used by: dash-backend/config/mail.php.
MAIL_FROM_ADDRESS="info@example.com"

# Default Reply-To address.
# Used by: dash-backend/config/mail.php or custom mail builders.
MAIL_FROM_REPLY_TO="info@example.com"

# Default From display name.
# Used by: dash-backend/config/mail.php.
MAIL_FROM_NAME="${APP_NAME}"

# CloudWatch log group name.
# Used by: AWS logging integrations and deployment scripts.
CLOUDWATCH_LOG_NAME="${APP_NAME}-${APP_ENV}"

# CloudWatch log stream name.
# Used by: AWS logging integrations and deployment scripts.
CLOUDWATCH_LOG_STREAM_NAME="${APP_NAME}-stream-${APP_ENV}"

# Frontend-exposed Pusher key for Mix builds.
# Used by: frontend asset build env interpolation.
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"

# Frontend-exposed Pusher cluster for Mix builds.
# Used by: frontend asset build env interpolation.
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Frontend base URL.
# Used by: dash-backend/config/app.php, auth URLs, and tenant links.
FRONTEND_URL=http://localhost:3000

# Editor integration for Ignition error pages.
# Used by: dash-backend/config/ignition.php or equivalent dev tooling.
IGNITION_EDITOR="vscode"

# Local path mapping for Ignition clickable links.
# Used by: Ignition local site mapping in development.
IGNITION_LOCAL_SITES_PATH=/var/www/dash/work/dash/laravel/subdomain.example.com

# Xdebug modes for the Sail-compatible container.
# Used by: php.ini/Xdebug startup and dev debugging.
SAIL_XDEBUG_MODE=develop,debug

# Optional explicit Xdebug client host.
# Used by: Xdebug runtime when uncommented.
# SAIL_XDEBUG_CONFIG="client_host=192.168.1.100"

# Toggle application mail sending.
# Used by: app mail/notification flows and custom guards around email delivery.
APP_MAIL_ENABLED=true

# API throttle rate default.
# Used by: route throttling or custom API limiter logic.
API_THROTTLE_RATE=300

# Optional: disable Laravel Pulse recording in local dev to avoid unnecessary DB writes.
# Used by: dash-backend/config/pulse.php.
# Pulse tables (pulse_entries, pulse_values, pulse_aggregates) ARE included in core migrations
# (2023_06_07_000001_create_pulse_tables.php) and are always created by migrate:fresh on pgsql.
# This setting only controls whether Pulse actively records request/queue/cache telemetry.
PULSE_ENABLED=false

# reCAPTCHA site key.
# Used by: service integrations and validation flows.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# reCAPTCHA secret key.
# Used by: backend verification logic for reCAPTCHA.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Maps API key.
# Used by: maps/geocoding integrations in app or domain code.
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# Deployment environment label.
# Used by: deployment scripts and Docker/runtime conventions.
ENV=staging

# Project short name.
# Used by: deployment scripts, naming, and Docker/runtime helpers.
PROJECT_NAME=dash

# Public project domain.
# Used by: deployment scripts and web server/tunnel setup.
PROJECT_DOMAIN=domain.com

# Server name for local/runtime web serving.
# Used by: web server config and deployment scripts.
SERVER_NAME=localhost

# AWS account id.
# Used by: deployment scripts and AWS integrations.
AWS_ACCOUNT=000000000000

# AWS access key id.
# Used by: deployment scripts and AWS SDK integrations.
AWS_ACCESS_KEY_ID=MOCK_AWS_ACCESS_KEY_ID

# AWS secret access key.
# Used by: deployment scripts and AWS SDK integrations.
AWS_SECRET_ACCESS_KEY=MASKED_AWS_SECRET_ACCESS_KEY

# Named local AWS CLI profile.
# Used by: deployment scripts.
AWS_LOCAL_PROFILE=mock_profile

# Default AWS region.
# Used by: deployment scripts and AWS SDK integrations.
AWS_DEFAULT_REGION=us-east-1

# CodeBuild build identifier/tag.
# Used by: CI/CD scripts and image tagging flows.
CODEBUILD_BUILD_NUMBER=latest

# Default seeded user password fallback.
# Used by: seeders or bootstrap helpers.
USER_PASSWORD=abcd1234...

# GitHub owner for the mounted domain repository.
# Used by: domain fetch/update automation scripts.
DOMAIN_GITHUB_OWNER=client

# GitHub repository for the mounted domain.
# Used by: domain fetch/update automation scripts.
DOMAIN_GITHUB_REPO=client-domain-repo

# GitHub token for private domain repository access.
# Used by: domain fetch/update automation scripts.
DOMAIN_GITHUB_TOKEN=MASKED_GITHUB_TOKEN

# Optional explicit branch for domain checkout in staged environments.
# Used by: domain fetch/update automation scripts when uncommented.
#DOMAIN_GITHUB_BRANCH=production

# TLS certificate path for secure Reverb/websocket serving.
# Used by: dash-backend/config/reverb.php or websocket TLS boot logic.
REVERB_TLS_CERT=/opt/certs/certificate.crt

# TLS private key path for secure Reverb/websocket serving.
# Used by: dash-backend/config/reverb.php or websocket TLS boot logic.
REVERB_TLS_KEY=/opt/certs/private.key

# TLS CA bundle path for secure Reverb/websocket serving.
# Used by: dash-backend/config/reverb.php or websocket TLS boot logic.
REVERB_TLS_CA=/opt/certs/ca_bundle.crt

# Google service account JSON path for Play/Google integrations.
# Used by: Google Pay or subscription verification services.
GOOGLE_SERVICE_ACCOUNT_PATH=/var/www/dash/google-service-account-mokup.json

# Android package name for Google subscription validation.
# Used by: Google Pay/subscription services.
GOOGLE_PACKAGE_NAME=com.yourapp.subscription

# Google OAuth client id.
# Used by: social auth config and callback flows.
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth client secret.
# Used by: social auth config and callback flows.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth callback URL.
# Used by: social auth config and callback flows.
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Toggle reCAPTCHA enforcement.
# Used by: captcha validation config and request guards.
RECAPTCHA_ENABLED=false

# Active reCAPTCHA site key.
# Used by: captcha validation config and frontend integration.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Active reCAPTCHA secret key.
# Used by: captcha validation config and backend verification.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# OpenAI API key.
# Used by: OpenAI service integrations under app/Services/OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# Optional OpenAI organization id.
# Used by: OpenAI service integrations when uncommented.
#OPENAI_ORGANIZATION=your_openai_org_id_here

# Default tenant display name used by bootstrap/seed flows.
# Used by: tenant bootstrap and seeders.
DEFAULT_TENANT_NAME="DASH"

# Default tenant public-facing display name.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_DISPLAY_NAME="Kitchen dashboard"

# Default tenant email.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_EMAIL="info@kitchentab.cl"

# Default tenant phone.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_PHONE="+56991285999"

# Default tenant website.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_WEBSITE="${FRONTEND_URL}"

# Default tenant street address.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_ADDRESS="Av. Los Acacios 5727, Conchalí, Santiago. "

# Default tenant logo URL.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_LOGO_URL="/assets/logo-squared.png"

# Default tenant primary color.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_PRIMARY_COLOR="#1a73e8"

# Default tenant secondary color.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_SECONDARY_COLOR="#34a853"

# Default tenant support email.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_SUPPORT_EMAIL=""

# Default tenant support phone.
# Used by: tenant bootstrap and branding defaults.
DEFAULT_TENANT_SUPPORT_PHONE=""

# Firebase credentials JSON path.
# Used by: Firebase notification/integration services.
FIREBASE_CREDENTIALS_PATH=/path/to/your/firebase-service-account.json

# Firebase project id.
# Used by: Firebase notification/integration services.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Disable tenant-role checks in notification debugging.
# Used by: notification preference and dispatch logic.
NOTIFICATIONS_DISABLE_TENANT_ROLE_CHECKING=false

# Rebill API base URL.
# Used by: payment gateway config and billing services.
REBILL_API_URL=https://api.rebill.com/v3

# Rebill API key.
# Used by: payment gateway config and billing services.
REBILL_API_KEY=your_rebill_api_key_here

# Rebill webhook signing secret.
# Used by: payment gateway webhook validation.
REBILL_WEBHOOK_SECRET=your_rebill_webhook_secret_here

# Rebill runtime environment.
# Used by: payment gateway config and billing services.
REBILL_ENVIRONMENT=sandbox

# Rebill default country.
# Used by: payment gateway config and billing services.
REBILL_DEFAULT_COUNTRY=CL

# Rebill default currency.
# Used by: payment gateway config and billing services.
REBILL_DEFAULT_CURRENCY=CLP

# Rebill public key for SDK/frontend flows.
# Used by: payment gateway config and client integrations.
REBILL_PUBLIC_KEY=your_rebill_public_key_for_sdk

# Flow API base URL.
# Used by: payment gateway config and billing services.
FLOW_API_URL=https://sandbox.flow.cl/api

# Flow API key.
# Used by: payment gateway config and billing services.
FLOW_API_KEY=your_flow_api_key_here

# Flow secret key.
# Used by: payment gateway config and billing services.
FLOW_SECRET_KEY=your_flow_secret_key_here

# Flow runtime environment.
# Used by: payment gateway config and billing services.
FLOW_ENVIRONMENT=sandbox

# Flow card registration method.
# Used by: payment gateway config and billing services.
FLOW_CARD_REGISTRATION_METHOD=redirect

# Flow default currency.
# Used by: payment gateway config and billing services.
FLOW_DEFAULT_CURRENCY=CLP

# Flow default country.
# Used by: payment gateway config and billing services.
FLOW_DEFAULT_COUNTRY=CL