# ----------------------------------------------------------------------------
# dash-backend-docker/.env.example
#
# Purpose:
# - This is the Docker Compose env file for the runtime-only stack in
#   dash-backend-docker.
# - docker-compose.yml reads these values while creating containers, ports,
#   mounted files, and helper services.
#
# Keep in sync with:
# - dash-backend-docker/docker-compose.yml
# - the app env file referenced by ENV_FILE
#
# Important:
# - Values here are resolved by Docker Compose, not by Laravel directly.
# - Database names and credentials must match the Laravel env file mounted into
#   the app container so the app and postgres services point to the same DBs.
# ----------------------------------------------------------------------------

# Compose project/container prefix.
# Used by: dash-backend-docker/docker-compose.yml for container, network, and volume names.
COMPOSE_PROJECT_NAME=dash_image

# Core Docker image tag to run.
# Used by: dash-backend-docker/docker-compose.yml -> app.image.
DASH_IMAGE=farandal/dash-backend:1.0.0-core

# Path to the Laravel env file mounted into /var/www/dash/.env inside the app container.
# Used by: dash-backend-docker/docker-compose.yml -> app.volumes.
ENV_FILE=../dash-backend/.env.dash.local

# Path to the mounted domain package.
# Used by: dash-backend-docker/docker-compose.yml -> app.volumes.
DOMAIN_PATH=../dash-backend-domain

# Host path for the app's storage/ dir (assets, logs, cache, sessions), mounted
# into /var/www/dash/storage. Kept on local disk and named after the domain project.
# Used by: dash-backend-docker/docker-compose.yml -> app.volumes.
STORAGE_PATH=./storage/dash-backend-domain

# Host path for the Postgres data directory, mounted into the pgsql container at
# /var/lib/postgresql/data. A bind mount (not a named volume) so the DB survives
# `docker compose down -v` and lives under this project's storage/ tree instead of
# Docker's opaque volume storage.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql.volumes.
DB_STORAGE_PATH=./storage/dash-backend-domain/pgsql-data

# Primary application database name.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql/pgsql_setup environment.
# Must match: DB_DATABASE in the env file referenced by ENV_FILE.
DB_DATABASE=dash_dev_db

# Testing database name used by php artisan test.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql/pgsql_setup environment.
# Must match: DB_DATABASE_TEST in the env file referenced by ENV_FILE.
DB_DATABASE_TEST=dash_dev_db_test

# PostgreSQL username shared by the app and database bootstrap services.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql/pgsql_setup environment.
# Must match: DB_USERNAME in the env file referenced by ENV_FILE.
DB_USERNAME=dashpanel

# PostgreSQL password shared by the app and database bootstrap services.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql/pgsql_setup environment.
# Must match: DB_PASSWORD in the env file referenced by ENV_FILE.
DB_PASSWORD=12345678

# External app port for the HTTP container.
# Used by: scripts/cloudflare-tunnel.sh and may be mirrored by DBI_APP_PORT.
APP_PORT=25000

# Public hostname for Cloudflare tunnel routing.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_TUNNEL_HOSTNAME=

# Cloudflare API token for tunnel and DNS automation.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_API_TOKEN=

# Cloudflare account identifier for tunnel automation.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_ACCOUNT_ID=

# Cloudflare DNS zone name for record creation.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_ZONE_NAME=

# Explicit Cloudflare zone id to avoid lookup-by-name.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_ZONE_ID=

# Explicit tunnel CNAME target when auto-derivation is not desired.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_TUNNEL_CNAME_TARGET=

# Inline Cloudflare named tunnel token.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_TUNNEL_TOKEN=

# File path to a Cloudflare named tunnel token.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_TUNNEL_TOKEN_FILE=

# Enable fallback when QUIC transport is blocked.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_QUIC_ERROR_FALLBACK_ENABLED=1

# Number of QUIC failures before fallback activates.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_QUIC_ERROR_FALLBACK_COUNT=3

# Time window, in seconds, for QUIC fallback counting.
# Used by: dash-backend-docker/scripts/cloudflare-tunnel.sh.
CF_QUIC_ERROR_FALLBACK_WINDOW_SEC=30

# Host port mapped to container port 80.
# Used by: dash-backend-docker/docker-compose.yml -> app.ports.
DBI_APP_PORT=25000

# Host port mapped to PostgreSQL 5432.
# Used by: dash-backend-docker/docker-compose.yml -> pgsql.ports.
DBI_FORWARD_DB_PORT=25432

# Host port mapped to Redis 6379.
# Used by: dash-backend-docker/docker-compose.yml -> redis.ports.
DBI_FORWARD_REDIS_PORT=25379

# Host port mapped to Mailhog SMTP port 1025.
# Used by: dash-backend-docker/docker-compose.yml -> mailhog.ports.
DBI_FORWARD_MAILHOG_PORT=25025

# Host port mapped to Mailhog web UI port 8025.
# Used by: dash-backend-docker/docker-compose.yml -> mailhog.ports.
DBI_FORWARD_MAILHOG_DASHBOARD_PORT=25026

# Host port mapped to Reverb server port 6001.
# Used by: dash-backend-docker/docker-compose.yml -> app.ports.
DBI_REVERB_SERVER_PORT=25001

# Public application URL used by helper scripts and external clients.
# Used by: helper scripts in dash-backend-docker and developer tooling.
APP_URL=http://localhost:3006
