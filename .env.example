COMPOSE_PROJECT_NAME=dash_image

# Docker Hub image must contain the Laravel core (artisan, app/, routes/, vendor/)
DASH_IMAGE=farandal/dash-backend:1.0.0-core

# Reuse your existing local backend env file
ENV_FILE=../dash-backend/.env.dash.local

# Mount client domain logic into /var/www/html/domain
DOMAIN_PATH=../dash-backend-domain

# Database credentials — must match what's in your ENV_FILE
# These are used to initialize the postgres container
DB_DATABASE=dash_dev_db
DB_DATABASE_TEST=dash_dev_db_test
DB_USERNAME=dashpanel
DB_PASSWORD=12345678

# Host port exposed by the app container; used by scripts/cloudflare-tunnel.sh
APP_PORT=25000

# Cloudflare tunnel hostname for the development domain
CF_TUNNEL_HOSTNAME=

# Cloudflare API token and account metadata for DNS and tunnel management
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_NAME=
# Optional but recommended: explicit zone id (avoids zone-name lookup issues)
CF_ZONE_ID=
# Optional: tunnel CNAME target for DNS API automation (example: 1234abcd.cfargotunnel.com).
# Leave empty to auto-derive from CF_TUNNEL_TOKEN or CF_TUNNEL_TOKEN_FILE.
CF_TUNNEL_CNAME_TARGET=

# Named tunnel credential. Set one of these when you already created the tunnel in Cloudflare Zero Trust.
CF_TUNNEL_TOKEN=
CF_TUNNEL_TOKEN_FILE=
# Optional named-tunnel resilience on restrictive networks (QUIC blocked by firewall)
CF_QUIC_ERROR_FALLBACK_ENABLED=1
CF_QUIC_ERROR_FALLBACK_COUNT=3
CF_QUIC_ERROR_FALLBACK_WINDOW_SEC=30

# Service ports (override if occupied on your machine)
DBI_APP_PORT=25000
DBI_FORWARD_DB_PORT=25432
DBI_FORWARD_REDIS_PORT=25379
DBI_FORWARD_MAILHOG_PORT=25025
DBI_FORWARD_MAILHOG_DASHBOARD_PORT=25026
DBI_REVERB_SERVER_PORT=25001
APP_URL=http://localhost:3006
